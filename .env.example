# ══════════════════════════════════════════════════════════════════
# Property Finder — Production Environment
# Copy this to .env and fill in your values
# ══════════════════════════════════════════════════════════════════

# ─── Domain & API ─────────────────────────────────────────────────
# Your domain or subdomain (used in Nginx config on VPS)
DOMAIN=property.yourdomain.com

# Full URL to backend API — must match what frontend will call
# After SSL is set up on VPS Nginx, use https://
VITE_API_URL=https://property.yourdomain.com/api

# CORS — set to your frontend domain for security
CORS_ORIGINS=https://property.yourdomain.com

# ─── Ports (change if these are already taken on your VPS) ────────
BACKEND_PORT=8001
FRONTEND_PORT=3001
